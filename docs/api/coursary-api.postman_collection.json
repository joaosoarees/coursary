{
  "info": {
    "name": "Coursary API",
    "description": "Rotas da coursary-api. Importe no Yaak (Import > Postman) e preencha baseUrl com o endpoint do stage, mostrado no fim de `pnpm deploy:dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.sa-east-1.amazonaws.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/sign-up",
            "description": "201 { accountId }. 409 EMAIL_IN_USE, 400 VALIDATION, 400 INVALID_PASSWORD, 429 TOO_MANY_REQUESTS."
          }
        }
      ]
    }
  ]
}
