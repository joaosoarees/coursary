{
  "info": {
    "name": "Coursary API",
    "description": "Rotas da coursary-api. Importe no Yaak (Import > Postman) e o baseUrl aponta para o domínio de `dev`; em `prod`, use https://api.coursary.joaodevdude.com.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-dev.coursary.joaodevdude.com"
    },
    {
      "key": "accessToken",
      "value": "<accessToken do sign-in>"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/sign-up",
            "description": "201 { accountId }. 409 EMAIL_IN_USE, 400 VALIDATION, 400 INVALID_PASSWORD, 429 TOO_MANY_REQUESTS."
          }
        },
        {
          "name": "Confirm sign-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/confirm",
            "description": "204. 400 INVALID_CODE (código errado, expirado, ou sem cadastro pendente), 400 VALIDATION, 429 TOO_MANY_REQUESTS."
          }
        },
        {
          "name": "Resend confirmation code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/resend-code",
            "description": "204 sempre, exista ou não um cadastro pendente. 400 VALIDATION, 429 TOO_MANY_REQUESTS."
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/sign-in",
            "description": "200 { accessToken, refreshToken, expiresIn }. 401 INVALID_CREDENTIALS, 403 EMAIL_NOT_CONFIRMED, 403 ACCOUNT_UNAVAILABLE, 429 TOO_MANY_REQUESTS."
          }
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<refreshToken do sign-in>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/refresh",
            "description": "200 { accessToken, refreshToken, expiresIn }: guarde o refreshToken novo, o antigo deixa de valer (rotação). 401 INVALID_SESSION, 403 ACCOUNT_UNAVAILABLE."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "204 sempre; o código só é enviado a uma conta ativa. 400 VALIDATION, 429 TOO_MANY_REQUESTS."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"newsecret1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "204, e todas as sessões anteriores são encerradas. 400 INVALID_CODE, 400 INVALID_PASSWORD, 400 VALIDATION, 429 TOO_MANY_REQUESTS."
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/me",
            "description": "200 { id, name, email, role, createdAt }. 401 sem token ou token inválido (API Gateway), 403 com o id token (escopo) ou conta indisponível (ACCOUNT_UNAVAILABLE)."
          }
        },
        {
          "name": "Update me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/me",
            "description": "200 com o perfil atualizado. 400 VALIDATION, 401, 403 como no Get me."
          }
        }
      ]
    }
  ]
}
