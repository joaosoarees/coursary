{
  "info": {
    "name": "Coursary API",
    "description": "Rotas da coursary-api. Importe no Yaak (Import > Postman) e preencha baseUrl com o endpoint do stage, mostrado no fim de `pnpm deploy:dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.sa-east-1.amazonaws.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
